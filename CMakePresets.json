{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with examples and tests",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CLOADER_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build with examples and tests",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CLOADER_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "docs",
            "displayName": "Documentation",
            "description": "Release build with examples and Doxygen documentation",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/docs",
            "cacheVariables": {
                "CLOADER_BUILD_DOCS": "ON",
                "CLOADER_DOCS_OUTPUT_DIRECTORY": "${sourceDir}/build/docs"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage",
            "description": "Debug build with code coverage instrumentation",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/cov",
            "cacheVariables": {
                "CLOADER_BUILD_COVERAGE": "ON",
                "CLOADER_COVERAGE_OUTPUT_DIR": "${sourceDir}/build/coverage"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "docs",
            "configurePreset": "docs",
            "targets": [
                "docs"
            ]
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "targets": [
                "coverage"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}